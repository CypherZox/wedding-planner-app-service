{
  "bsonType": "object",
  "additionalProperties": false,
  "required": ["_id", "weddingId", "sv", "version", "createdAt", "updatedAt", "createdBy", "updatedBy", "scope", "title", "date", "order", "items"],
  "properties": {
    "_id": { "bsonType": "objectId" },
    "weddingId": { "bsonType": "objectId" },
    "sv": { "bsonType": "int", "minimum": 1 },
    "version": { "bsonType": "int", "minimum": 1 },
    "createdAt": { "bsonType": "date" },
    "updatedAt": { "bsonType": "date" },
    "createdBy": { "bsonType": "objectId" },
    "updatedBy": { "bsonType": "objectId" },
    "deletedAt": { "bsonType": "date" },
    "scope": { "bsonType": "string", "enum": ["wedding", "honeymoon"] },
    "title": { "bsonType": "string", "maxLength": 200 },
    "date": { "bsonType": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "order": { "bsonType": "int" },
    "items": {
      "bsonType": "array",
      "maxItems": 100,
      "items": {
        "bsonType": "object",
        "additionalProperties": false,
        "required": ["id", "time", "title", "assigneeIds"],
        "properties": {
          "id": { "bsonType": "string", "pattern": "^[0-9A-Za-z]{8}$" },
          "time": { "bsonType": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
          "endTime": { "bsonType": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
          "title": { "bsonType": "string", "maxLength": 200 },
          "location": { "bsonType": "string", "maxLength": 200 },
          "assigneeIds": { "bsonType": "array", "items": { "bsonType": "objectId" } },
          "assigneeNote": { "bsonType": "string", "maxLength": 4000 },
          "details": { "bsonType": "string", "maxLength": 4000 }
        }
      }
    }
  }
}
