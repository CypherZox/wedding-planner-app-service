{
  "bsonType": "object",
  "additionalProperties": false,
  "required": ["_id", "weddingId", "sv", "version", "createdAt", "updatedAt", "createdBy", "updatedBy", "scope", "kind", "categoryId", "description", "amountMinor", "status"],
  "properties": {
    "_id": { "bsonType": "objectId" },
    "weddingId": { "bsonType": "objectId" },
    "sv": { "bsonType": "int", "minimum": 1 },
    "version": { "bsonType": "int", "minimum": 1 },
    "createdAt": { "bsonType": "date" },
    "updatedAt": { "bsonType": "date" },
    "createdBy": { "bsonType": "objectId" },
    "updatedBy": { "bsonType": "objectId" },
    "deletedAt": { "bsonType": "date" },
    "scope": { "bsonType": "string", "enum": ["wedding", "honeymoon"] },
    "kind": { "bsonType": "string", "enum": ["expense", "installment"] },
    "vendorId": { "bsonType": "objectId" },
    "categoryId": { "bsonType": "string", "pattern": "^[0-9A-Za-z]{8}$" },
    "description": { "bsonType": "string", "maxLength": 1000 },
    "amountMinor": { "bsonType": "long", "minimum": 1 },
    "status": { "bsonType": "string", "enum": ["scheduled", "paid"] },
    "dueDate": { "bsonType": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "paidOn": { "bsonType": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "paidByContributorId": { "bsonType": "string", "pattern": "^[0-9A-Za-z]{8}$" },
    "method": { "bsonType": "string", "enum": ["cash", "card", "transfer", "other"] },
    "receiptMediaId": { "bsonType": "objectId" },
    "original": {
      "bsonType": "object",
      "additionalProperties": false,
      "required": ["amountMinor", "currency", "rateMicros"],
      "properties": {
        "amountMinor": { "bsonType": "long", "minimum": 1 },
        "currency": { "bsonType": "string", "pattern": "^[A-Z]{3}$" },
        "rateMicros": { "bsonType": "long" }
      }
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": { "kind": { "enum": ["expense"] } },
          "not": { "required": ["vendorId"] }
        },
        {
          "properties": { "kind": { "enum": ["installment"] } },
          "required": ["vendorId"]
        }
      ]
    },
    {
      "oneOf": [
        {
          "properties": { "status": { "enum": ["scheduled"] } },
          "required": ["dueDate"]
        },
        {
          "properties": { "status": { "enum": ["paid"] } },
          "required": ["paidOn"]
        }
      ]
    }
  ]
}
